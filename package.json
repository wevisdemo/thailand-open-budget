{
  "name": "thailand-open-budget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/split-budget-by-ministry.mjs && next dev",
    "build": "node scripts/split-budget-by-ministry.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "data:fetch": "node scripts/fetch-budget-data.mjs",
    "data:index": "node scripts/fetch-index-data.mjs",
    "data:import": "node scripts/import-all.mjs",
    "data:organizations": "node scripts/build-organizations.mjs",
    "data:core": "node scripts/fetch-core-content.mjs",
    "data:split": "node scripts/split-budget-by-ministry.mjs",
    "sass:build": "sass --load-path=node_modules --style=compressed --no-source-map src/styles/carbon/index.scss src/styles/carbon/pre-compiled.css",
    "sass:build:react": "sass --load-path=node_modules --load-path=node_modules/.pnpm/node_modules --style=compressed --no-source-map --quiet-deps src/styles/carbon-react/index.scss src/styles/carbon-react/pre-compiled.css",
    "prepare": "husky"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.90.0",
    "@carbon/react": "^1.118.0",
    "carbon-components": "^10.59.2",
    "d3-hierarchy": "3.1.2",
    "fuse.js": "^7.5.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "^1.99.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
